PORT=3000
DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=
DB_NAME=shrees_extractions
SESSION_SECRET=change-me
UPLOAD_DIR=../uploads

# Cloud / Vercel (optional — leave blank for local XAMPP)
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Cloudflare R2 or any S3-compatible store (recommended for 1–5 GB videos)
# Create a free R2 bucket, API token, then set:
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=extract-files
S3_FORCE_PATH_STYLE=true
# Optional public CDN/base URL. If empty, short-lived signed URLs are used.
S3_PUBLIC_URL=

# R2 bucket CORS (required for browser multipart upload):
# Allowed Origins: https://shrees-extractions.vercel.app (and http://localhost:3000)
# Allowed Methods: GET, PUT, HEAD
# Allowed Headers: *
# Expose Headers: ETag
# Max Age: 86400
